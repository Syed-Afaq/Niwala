# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string.
# When running Postgres via the root docker-compose.yml, this matches its defaults:
DATABASE_URL="postgresql://niwala:niwala@localhost:5433/niwala?schema=public"

# Port the Express API listens on
PORT=4000

# Secret used to sign JWTs — use a long random string in real deployments
JWT_SECRET="change-this-to-a-long-random-secret"

# JWT expiry (e.g. "7d", "1h")
JWT_EXPIRES_IN="7d"
